# Grid Dashboard (testnet, vite, порт 5175).
# VITE_API_URL — относительный путь: запросы идут на /api и проксируются
# vite-сервером в DASHBOARD_API_TARGET.
VITE_API_URL=/api
DASHBOARD_API_TARGET=http://api-testnet:5000
VITE_NOTIFY_TOKEN=747b09901fc24dd5a61a92c37f359ff2252403ec96344e69945d1583790adbe3
# Сетки считает серверный движок внутри api-server (GRID_ENGINE_ENABLED=true),
# а дашборд только отображает их через /api/grids.
VITE_GRID_ENGINE=server
