# API base URL (по умолчанию http://localhost:5000/api).
VITE_API_URL=http://localhost:5000/api

# Тот же NOTIFY_TOKEN из корневого .env — дашборд шлёт его в x-notify-token.
# Значение попадает в клиентский бандл, это не секрет.
# VITE_NOTIFY_TOKEN=

# Phase 3: режим движения сеток.
#   browser (по умолчанию) — сетки считаются и исполняются в этом браузере, как раньше.
#   server                 — дашборд становится viewer'ом: источник истины /api/grids,
#                            а торговлю ведёт серверный grid-движок api-server.
# VITE_GRID_ENGINE=browser
