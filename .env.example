# ============================================
# Общий .env файл для всех сервисов
# При изменении ключей — измените только здесь
# ============================================

# Binance API Keys
BINANCE_API_KEY=YOUR_API_KEY_HERE
BINANCE_API_SECRET=YOUR_API_SECRET_HERE

# API Server
PORT=5000
BOT_DIR=./bot
DATABASE_PATH=./data/bot.db

# Support Telegram bot
SUPPORT_BOT_TOKEN=your_support_bot_token
SUPPORT_CHAT_ID=your_support_chat_id
SUPPORT_BOT_MASTER_KEY=base64_32_bytes
SUPPORT_BOT_DB=./support-bot/data/support_bot.db