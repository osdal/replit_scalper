# ============================================
# Общий .env файл для всех сервисов
# При изменении ключей — измените только здесь
# ============================================

# Binance API Keys
BINANCE_API_KEY=YOUR_API_KEY_HERE
BINANCE_API_SECRET=YOUR_API_SECRET_HERE

# Разрешает серверные grid-роуты (/api/grid-orders/*); включать только вместе с тестнетом.
GRID_ORDERS_ENABLED=false

# Необязательный allowlist символов для grid-ордеров (через запятую, напр. BTCUSDT,ETHUSDT).
# Пусто = без ограничений. Символы вне списка отклоняются с 409.
GRID_SYMBOLS=

# Серверный grid-движок (фазы 2a/2b: активация, филлы, защита, закрытие/финализация).
# INERT по умолчанию — включать только осознанно (работает лишь со строками engine='server').
# GRID_ENGINE_ENABLED=false
# Интервал tick-цикла движка в мс (по умолчанию 15000).
# GRID_ENGINE_INTERVAL_MS=15000

# Auto-mode серверного grid-движка (создание waiting-сеток из символов ботов).
# По умолчанию выключен; имеет эффект только при GRID_ENGINE_ENABLED=true.
# GRID_AUTO_ENABLED=false
# Максимум новых сеток за один tick (по умолчанию 3).
# GRID_AUTO_MAX=3
# Общий потолок одновременно active/waiting сеток (по умолчанию 10).
# GRID_AUTO_TOTAL_MAX=10
# Размер одного ордера авто-сетки в USD (по умолчанию 10).
# GRID_AUTO_ORDER_USD=10
# Плечо авто-сеток (по умолчанию 50; при выставке ограничивается биржей).
# GRID_AUTO_LEVERAGE=50

# API Server
PORT=5000
BOT_DIR=./bot
DATABASE_PATH=./data/bot.db
# Явный путь к Python, в котором установлены зависимости бота (pandas, python-binance и т.д.).
# Используется API сервером при запуске ботов через дашборд. На Windows может быть нужно
# указать полный путь, если 'python' из PATH указывает на другой интерпретатор без зависимостей.
# Пример: BOT_PYTHON=C:/Users/osdal/AppData/Local/Programs/Python/Python311/python.exe
BOT_PYTHON=

# Support Telegram bot
SUPPORT_BOT_TOKEN=your_support_bot_token_from_BotFather
SUPPORT_CHAT_ID=your_chat_id
SUPPORT_BOT_MASTER_KEY=base64_32_bytes
SUPPORT_BOT_DB=./support-bot/data/support_bot.db